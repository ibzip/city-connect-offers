{
  "name": "city-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@city-wallet/api-gateway --filter=@city-wallet/consumer-wallet --filter=@city-wallet/merchant-portal",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "sqlite3 prisma/dev.db < prisma/migrations/000001_init/migration.sql",
    "db:seed": "node --import tsx prisma/seed.ts",
    "cdk:synth": "pnpm --filter @city-wallet/infra-aws cdk synth",
    "cdk:deploy": "pnpm --filter @city-wallet/infra-aws cdk deploy",
    "test": "turbo run test"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.810.0",
    "@prisma/client": "^5.22.0",
    "@types/aws-lambda": "^8.10.147",
    "aws-cdk-lib": "^2.190.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "constructs": "^10.4.2",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.462.0",
    "next": "^15.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "aws-cdk": "^2.1007.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.4",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
