DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3010"
SERVICE_INVOCATION_MODE="local"
CITY_WALLET_REPOSITORY="prisma"

CONTEXT_SERVICE_URL=
MERCHANT_INTELLIGENCE_SERVICE_URL=
NEGOTIATION_SERVICE_URL=
VALIDATION_SERVICE_URL=
OFFER_SERVICE_URL=
REDEMPTION_SERVICE_URL=
ANALYTICS_SERVICE_URL=

CONSUMER_WALLET_ORIGIN="http://localhost:3000"
MERCHANT_PORTAL_ORIGIN="http://localhost:3001"

# Optional real integrations. The seeded product path works without them.
OPENAI_API_KEY=
# LLM_PROVIDER controls the user-context + negotiation pipeline:
#   mock_llm    : assembler/user-negotiator are skipped; backend negotiator uses the deterministic mock client.
#   azure_openai: all three agents run as real Azure OpenAI calls. Strict-halt on any failure.
LLM_PROVIDER="mock_llm"
# Required when LLM_PROVIDER=azure_openai (no built-in defaults):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# Optional. Defaults to 2024-10-21 if unset.
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_TIMEOUT_MS=15000
# Optional. When unset, no `temperature` is sent and the model uses its default.
# Reasoning-class deployments (o1/o3/gpt-5) reject any non-default value.
# Set this only if you're on a chat-class deployment (e.g. gpt-4o) and want
# lower-temperature, more deterministic JSON output (e.g. 0.1).
AZURE_OPENAI_TEMPERATURE=
PAYONE_API_KEY=
WEATHER_API_KEY=
TAVILY_API_KEY=
NOMINATIM_USER_AGENT="CityWalletHackathonMVP/0.1 local-dev"
OVERPASS_USER_AGENT="CityWalletHackathonMVP/0.1 local-dev"
CITY_IMPORT_POI_PROVIDER="google_places"
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_REQUESTS_PER_IMPORT=1000
# Optional cost guard for the per-import merchant cap. Unset means the global hard cap (100_000) wins.
# GOOGLE_PLACES_MAX_IMPORTED_MERCHANTS=
GOOGLE_PLACES_DEFAULT_RADIUS_METERS=20000
GOOGLE_PLACES_TIMEOUT_MS=6000
CITY_IMPORT_RUNTIME_BUDGET_MS=180000
ENABLE_OVERPASS_IMPORT_FALLBACK=true

ENABLE_WALLET_LIVE_DISCOVERY_FALLBACK=false

# Optional local-only reset endpoint. Prefer pnpm db:seed.
ENABLE_DEV_RESET=false

# User context intelligence pipeline
# Server-only flag; the Consumer Wallet's /dev/context-simulator page probes the
# api-gateway at runtime and renders a "disabled" state when this is not true.
ENABLE_DEV_CONTEXT_SIMULATOR=false
CONTEXT_SNAPSHOT_TTL_MINUTES=15
LOCATION_CHANGE_THRESHOLD_METERS=50
USER_CONTEXT_AGENT_TIMEOUT_MS=12000
USER_NEGOTIATOR_AGENT_TIMEOUT_MS=12000
DEBUG_STORE_RAW_CONTEXT=false
# When true, log the raw LLM agent response and Zod failure reason on the first
# (pre-repair) validation failure. The repair-attempt failure is always logged.
DEBUG_LLM_AGENTS=false
